# Copy to .env and adjust. .env is gitignored.

# Match the container user to your host user so mounted files aren't root-owned:
#   UID=$(id -u)  GID=$(id -g)
UID=1000
GID=1000

# Host path to the project checkout that gets mounted at /workspace.
# On Unraid use an ABSOLUTE cache-pool path, e.g. /mnt/user/appdata/atem-av-fw
PROJECT_DIR=../atem-av-fw

# Where the ~100GB Vivado install lives (bind-mounted to /opt/Xilinx). Keep it on
# fast storage. On Unraid use a cache-pool path, e.g. /mnt/user/appdata/vivado/xilinx
XILINX_DIR=./_xilinx

# Node-locked license file, if you have one (free ML Standard usually needs none).
# Place the .lic under ./licenses and point at it inside the container:
# XILINXD_LICENSE_FILE=/licenses/Xilinx.lic
XILINXD_LICENSE_FILE=
